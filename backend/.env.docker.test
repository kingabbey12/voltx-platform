# The docker-compose variant of .env.test — same contract, container
# hostnames. Keep the two in step: anything that changes how the suite
# behaves (below all belongs in both) must be declared in both.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://voltx:voltx@postgres:5432/voltx

# Queue-backed work must run inline; see the note in .env.test.
REDIS_ENABLED=false

# Outbound providers pinned off so a containerised run cannot spend money.
OPENAI_ENABLED=false
ANTHROPIC_ENABLED=false
GOOGLE_AI_ENABLED=false
AZURE_OPENAI_ENABLED=false
OTEL_ENABLED=false
SENTRY_DSN=
JWT_ACCESS_SECRET=test-only-jwt-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=test-only-jwt-refresh-secret-0123456789abcdef
INTEGRATIONS_ENCRYPTION_KEY=test-only-encryption-key-0123456789abcdef
GOOGLE_OAUTH_CLIENT_ID=test-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=test-google-client-secret
MICROSOFT_OAUTH_CLIENT_ID=test-microsoft-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=test-microsoft-client-secret
SLACK_OAUTH_CLIENT_ID=test-slack-client-id
SLACK_OAUTH_CLIENT_SECRET=test-slack-client-secret
SLACK_SIGNING_SECRET=test-slack-signing-secret
# configuration.ts reads STRIPE_API_KEY; STRIPE_SECRET_KEY was read by nothing.
STRIPE_API_KEY=sk_test_dummy_billing_key
STRIPE_WEBHOOK_SECRET=whsec_dummy_billing_test_webhook_secret
MARKETPLACE_STRIPE_WEBHOOK_SECRET=whsec_dummy_marketplace_test_webhook_secret
AUTH_RATE_LIMIT_LIMIT=10000
RATE_LIMIT_LIMIT=100000
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=100000
