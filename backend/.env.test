# Authoritative environment for `pnpm test` and `pnpm test:e2e`.
#
# This file is the ONLY env file loaded when NODE_ENV=test (see the
# envFilePath comment in src/app.module.ts). Nothing falls through to
# .env.local or .env, so a developer's personal config can never change how
# the suite behaves — a run here is the same run CI performs.
#
# Consequently every variable the suite depends on must be declared here,
# including the ones whose value is "off". Adding a feature that reads a new
# env var means adding it here too, or it silently takes its production
# default under test.

NODE_ENV=test
PORT=3000
LOG_LEVEL=silent

DATABASE_URL=postgresql://voltx:voltx@localhost:5433/voltx_test

JWT_ACCESS_SECRET=ci-jwt-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=ci-jwt-refresh-secret-minimum-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m

INTEGRATIONS_ENCRYPTION_KEY=ci-only-integrations-encryption-key
INTEGRATIONS_WEBHOOK_BASE_URL=http://localhost:3000

# Queue-backed work (workflow runs, attachment processing, agent tasks) runs
# INLINE when this is not "true". The suite asserts on completed state
# immediately after the triggering request, so enabling Redis here makes that
# work asynchronous and those assertions observe PENDING instead. Keep false.
REDIS_ENABLED=false

# Every outbound provider is explicitly disabled: a test run must never spend
# money or emit telemetry, and these are the switches that guarantee it.
OPENAI_ENABLED=false
ANTHROPIC_ENABLED=false
GOOGLE_AI_ENABLED=false
AZURE_OPENAI_ENABLED=false
OTEL_ENABLED=false
SENTRY_DSN=

# Placeholder third-party credentials. Present so the OAuth/webhook routes
# construct and validate, never valid enough to reach a real service.
GOOGLE_OAUTH_CLIENT_ID=test-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=test-google-client-secret
MICROSOFT_OAUTH_CLIENT_ID=test-microsoft-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=test-microsoft-client-secret
SLACK_OAUTH_CLIENT_ID=test-slack-client-id
SLACK_OAUTH_CLIENT_SECRET=test-slack-client-secret
SLACK_SIGNING_SECRET=test-slack-signing-secret

# Note the name: configuration.ts reads STRIPE_API_KEY. An earlier test env
# set STRIPE_SECRET_KEY, which nothing reads.
STRIPE_API_KEY=sk_test_dummy_billing_key
STRIPE_WEBHOOK_SECRET=whsec_dummy_billing_test_webhook_secret
MARKETPLACE_STRIPE_WEBHOOK_SECRET=whsec_dummy_marketplace_test_webhook_secret

# High enough that throttling never causes a spurious failure when the suite
# hammers an endpoint, low enough that the guards are still wired up.
AUTH_RATE_LIMIT_LIMIT=10000
AUTH_RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100000
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=100000
