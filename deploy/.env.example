# ── Voltx — Production / Staging Environment ──────────────────────────
# Copy this to .env and fill in the secrets. The .env file is
# gitignored — it must never be committed.
#
#   cp .env.example .env && $EDITOR .env
#
# ── Required secrets (generate before deploying) ──────────────────────
#   openssl rand -base64 48   →  JWT_ACCESS_SECRET
#   openssl rand -base64 32   →  JWT_REFRESH_SECRET
#   openssl rand -base64 32   →  INTEGRATIONS_ENCRYPTION_KEY
#   openssl rand -base64 12   →  POSTGRES_PASSWORD
#   openssl rand -hex 16      →  REDIS_PASSWORD
#
# ── SECURITY NOTICE ───────────────────────────────────────────────────
# The .env file must be readable only by the deploy user:
#   chmod 600 deploy/.env
#
# For production, prefer injecting secrets via host environment
# variables or Docker secrets over a flat .env file. See
# deploy/README.md for the migration path.

# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── Database (Postgres + pgvector) ────────────────────────────────────
POSTGRES_USER=voltx
POSTGRES_PASSWORD=<set-strong-password>
POSTGRES_DB=voltx
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_CONNECTION_LIMIT=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_QUERY_LOGGING_ENABLED=false
DATABASE_SLOW_QUERY_THRESHOLD_MS=500
DATABASE_TRANSACTION_MAX_WAIT_MS=10000
DATABASE_TRANSACTION_TIMEOUT_MS=30000

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_PASSWORD=<set-redis-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ── Auth (JWT) ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=<openssl rand -base64 48>
JWT_REFRESH_SECRET=<openssl rand -base64 48>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Security / networking ────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_LIMIT=10
REQUEST_BODY_LIMIT=1mb
CORS_ALLOWED_ORIGINS=https://staging.voltx.ai,https://voltx-staging.vercel.app
TRUSTED_PROXY_COUNT=1

# ── Security Center (MFA / API keys) ─────────────────────────────────
MFA_TOTP_ISSUER=Voltx Staging

# ── AI & Knowledge ────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=250
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ── Integrations ────────────────────────────────────────────────────
INTEGRATIONS_ENCRYPTION_KEY=<openssl rand -base64 32>
INTEGRATIONS_ENCRYPTION_KEY_PREVIOUS=
INTEGRATIONS_WEBHOOK_BASE_URL=https://api-staging.voltx.ai

# ── Attachment Storage (Cloudflare R2 / S3) ──────────────────────────
ATTACHMENTS_STORAGE_PROVIDER=s3
ATTACHMENTS_S3_BUCKET=voltx-attachments-prod
ATTACHMENTS_S3_REGION=auto
ATTACHMENTS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
ATTACHMENTS_S3_ACCESS_KEY_ID=<r2-access-key-id>
ATTACHMENTS_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
ATTACHMENTS_S3_FORCE_PATH_STYLE=false

# ── Monitoring ────────────────────────────────────────────────────────
# Bearer token Prometheus presents when scraping the API's /metrics.
# REQUIRED in production — the API refuses to boot without it, because
# /metrics is otherwise unauthenticated and unthrottled.
# Must be >= 32 chars. Write the same value to deploy/prometheus/metrics_token.
METRICS_AUTH_TOKEN=

# Alertmanager delivers to deploy/alertmanager/webhook_url (a file, not this
# variable — Alertmanager does not expand env vars in its config).
