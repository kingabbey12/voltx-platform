# ── Voltx Database Backup Schedule ───────────────────────────────────
# Install with: crontab deploy/crontab
# Or for the deploy user: crontab -u deploy deploy/crontab
#
# Environment variables must be set in the crontab or sourced from
# deploy/.env before running backup.sh.
#
# BACKUP_DIR — directory to store backups (default: deploy/backups/)
# BACKUP_RETENTION_DAYS — retention window (default: 14)
# COMPOSE_FILE — path to docker-compose.staging.yml

# ── Daily backup at 3:00 AM UTC ──────────────────────────────────────
# Runs inside the deploy/ directory so docker compose can find .env
BACKUP_DIR=/var/voltx/backups COMPOSE_FILE=/path/to/deploy/docker-compose.staging.yml \
0 3 * * * cd /path/to/deploy && ./scripts/backup.sh --docker >> /var/log/voltx/backup.log 2>&1

# ── Weekly integrity check (restore to scratch DB) ───────────────────
# This requires a separate scratch database. Uncomment and configure
# before relying on backups for disaster recovery.
#
# 0 5 * * 0 cd /path/to/deploy && gunzip -c ./backups/voltx-latest.sql.gz | psql "$SCRATCH_DATABASE_URL" && psql "$SCRATCH_DATABASE_URL" -c "SELECT count(*) FROM organizations;" >> /var/log/voltx/backup-verify.log 2>&1
