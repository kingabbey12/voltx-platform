# ── Voltx reverse proxy ───────────────────────────────────────────────
# This is a TEMPLATE. nginx:alpine's entrypoint runs envsubst over
# /etc/nginx/templates/*.template and writes the result to
# /etc/nginx/conf.d/, so ${WEB_HOST} and ${API_HOST} are substituted at
# container start from the environment.
#
# It was previously a static file with staging.voltx.ai / api-staging.voltx.ai
# hardcoded, which meant a production deploy answered on no production
# hostname at all. Only the substitution list below is expanded — $host,
# $http_upgrade and friends are escaped by naming them explicitly in
# NGINX_ENVSUBST_FILTER, so nginx's own variables survive.

upstream api {
    server api:3000;
}

upstream web {
    server web:3000;
}

# ── HTTP → HTTPS redirect ─────────────────────────────────────────────
server {
    listen 80;
    server_name ${WEB_HOST} ${API_HOST};
    return 301 https://$host$request_uri;
}

# ── API Server ────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_HOST};

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # Modern TLS
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    # `preload` is deliberately omitted: submitting to the HSTS preload list is
    # a hard-to-reverse commitment covering every subdomain of the parent
    # domain, and it must be a deliberate decision about voltx.ai as a whole —
    # not a default inherited from a config template. max-age + includeSubDomains
    # give the protection without the irreversible commitment.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy strict-origin-when-cross-origin;

    client_max_body_size 10m;

    location / {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_cache_bypass $http_upgrade;
    }

    location /api/v1/health {
        access_log off;
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /liveness {
        access_log off;
        return 200 "OK";
    }

    location = /readiness {
        access_log off;
        proxy_pass http://api;
    }
}

# ── Web App ───────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${WEB_HOST};

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # `preload` is deliberately omitted: submitting to the HSTS preload list is
    # a hard-to-reverse commitment covering every subdomain of the parent
    # domain, and it must be a deliberate decision about voltx.ai as a whole —
    # not a default inherited from a config template. max-age + includeSubDomains
    # give the protection without the irreversible commitment.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy strict-origin-when-cross-origin;

    # API proxy for client-side requests
    location /api/ {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # WebSocket for real-time features
    location /socket.io/ {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
    }

    # Static assets with long cache
    location /_next/static/ {
        proxy_pass http://web;
        proxy_cache_valid 200 365d;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
